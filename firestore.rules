rules_version = '2';

// Firestore only ever stores which accounts are linked (email, label, ink
// index, linkedAt) — never refresh tokens, which stay in on-device secure
// storage. So these rules just need to keep each signed-in user's own
// document tree private to them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/linkedAccounts/{accountId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
